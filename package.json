{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "stage": "next build && next start -p 3001",
    "lint": "eslint",
    "test": "node --test \"lib/**/*.test.ts\" \"components/**/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage \"lib/**/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "verify:full": "bash scripts/verify.sh --full",
    "test:e2e": "playwright test",
    "tokens:check": "node scripts/check-tokens.mjs && node scripts/check-token-refs.mjs",
    "songs-shape:check": "python3 contracts/check_songs_shape.py --shape contracts/songs.shape.json --drizzle db/schema.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
